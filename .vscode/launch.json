{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn dev",             // or npm run dev / yarn dev
      "cwd": "${workspaceFolder}/apps/web",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "API: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",             // runs your ts-node/nodemon/vite-node, etc.
      "cwd": "${workspaceFolder}/apps/api",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Web + API",
      "configurations": ["Web: dev", "API: dev"]
    }
  ]
}
